{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Benchmark float",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "cwd": "${workspaceFolder}",
            "args": [
                "-n 1000000",
                "-s 200000",
                "-f"
            ]
        },
        {
            "name": "Benchmark double",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "cwd": "${workspaceFolder}",
            "args": [
                "-n 5000",
                "-s 100",
                "-i 10",
                "-j 4096",
                "-k 4096",
                "-d"
            ]
        },
        {
            "name": "Benchmark All",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "cwd": "${workspaceFolder}",
            "args": [
                "-n 1000000",
                "-s 10000",
                "-i 1",
                "-j 40000",
                "-k 40000",
                "-a 1000",
                "-c 1000",
                "-fd"
            ]
        }
    ]
}